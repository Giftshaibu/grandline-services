# Published ecosystem defaults; override these for a different deployment.
VITE_HUB_URL=https://www.grandlineautomw.com
VITE_SERVICES_URL=https://services.grandlineautomw.com
VITE_MOBILITY_URL=https://grandline-mobility.vercel.app
VITE_API_BASE_URL=
VITE_CLERK_PUBLISHABLE_KEY=
# Server only, never VITE_ prefix. Configure both Clerk keys together.
CLERK_SECRET_KEY=
NITRO_PRESET=vercel

# Enable only against the implemented/configured backend; never falls back to samples.
VITE_SERVICES_LIVE=false
